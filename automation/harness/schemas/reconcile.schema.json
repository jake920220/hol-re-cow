{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "summary",
    "accepted_finding_ids",
    "declined_findings",
    "verification",
    "risks",
    "commit_created",
    "blocker"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["resolved", "blocked", "failed"]
    },
    "summary": {
      "type": "string"
    },
    "accepted_finding_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "declined_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "rationale"],
        "properties": {
          "id": {
            "type": "string"
          },
          "rationale": {
            "type": "string"
          }
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lint", "typecheck", "build", "test"],
      "properties": {
        "lint": {
          "type": "string",
          "enum": ["passed", "failed", "skipped"]
        },
        "typecheck": {
          "type": "string",
          "enum": ["passed", "failed", "skipped"]
        },
        "build": {
          "type": "string",
          "enum": ["passed", "failed", "skipped"]
        },
        "test": {
          "type": "string",
          "enum": ["passed", "failed", "skipped"]
        }
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "commit_created": {
      "type": "boolean"
    },
    "blocker": {
      "type": ["string", "null"]
    }
  }
}
